# VizsgaMester backend — környezeti változók
# Másold .env-re és töltsd ki a valós értékekkel.

# PostgreSQL kapcsolat (Render internal/external database URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true

# JWT titkos kulcs (generálj egy random stringet: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-secret

# Frontend URL (CORS engedélyezéshez)
FRONTEND_URL=https://vizsgamester.onrender.com

# Port (Render automatikusan beállítja, lokális dev-hez 3001)
PORT=3001
